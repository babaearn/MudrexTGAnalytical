# Bot Configuration
BOT_TOKEN=your_bot_token_here
TRACKED_BOT_USERNAME=Mudrextest_bot

# Admin Access (comma-separated user IDs)
ADMIN_IDS=123456789,987654321

# Signal Channel
INSIGHTS_CHANNEL_ID=-1002163454656

# Official Mudrex Group
OFFICIAL_GROUP_ID=-1001868775086

# Topics Configuration (JSON format - expandable)
# Format: {"<number>":{"id":<topic_id>,"name":"<topic_name>"}}
TOPICS={"1":{"id":89270,"name":"Market Intelligence"}}

# Database (will be provided by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:port/database

# Optional Settings
HISTORICAL_MESSAGE_LIMIT=1000
RATE_LIMIT_DELAY=0.5
UPDATE_VIEWS_INTERVAL_MINUTES=60
DAILY_SNAPSHOT_HOUR=0
